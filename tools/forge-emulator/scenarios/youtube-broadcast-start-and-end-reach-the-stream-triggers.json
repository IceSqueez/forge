{
  "name": "a YouTube broadcast starting and ending reach forge's stream online and offline triggers",
  "purpose": "forge learns that a broadcast went live only from its liveBroadcasts poll (broadcastStatus=active, once a minute) and that it ended from the chatEndedEvent its chat poll returns. With the fake broadcast offline at boot, starting it must surface as one youtube.stream.online carrying the broadcast id and title and run the online action; ending it must surface as youtube.stream.offline for that broadcast and run the offline action. A chat poll after the end is answered 403 liveChatEnded, as the API documents, and forge must not treat that as a second offline.",
  "fixture": {
    "youtube": {},
    "event_triggers": [
      { "trigger_kind": "youtube.stream.online", "action_name": "Went Live", "steps": [] },
      { "trigger_kind": "youtube.stream.offline", "action_name": "Went Offline", "steps": [] }
    ]
  },
  "fakes": {
    "youtube": { "live_at_boot": false, "broadcast_title": "emulator marathon" }
  },
  "steps": [
    { "do": { "forge_ready": { "within_ms": 60000 } } },
    {
      "do": { "youtube_broadcast": { "live": true } },
      "expect": [
        {
          "event": {
            "name": "online",
            "source": "you_tube",
            "kind": "youtube.stream.online",
            "payload": {
              "/broadcast_id": { "equals": "EmuBroadcst" },
              "/broadcast_title": { "equals": "emulator marathon" }
            },
            "within_ms": 90000
          }
        },
        {
          "event": {
            "name": "live_action",
            "source": "core",
            "kind": "action.start",
            "payload": { "/action_name": { "equals": "Went Live" } },
            "within_ms": 90000
          }
        },
        { "caused_by": { "effect": "live_action", "cause": "online" } },
        {
          "youtube_request": {
            "method": "GET",
            "path": "/youtube/v3/liveChat/messages",
            "status": 200,
            "within_ms": 90000
          }
        }
      ]
    },
    {
      "do": { "youtube_broadcast": { "live": false } },
      "expect": [
        {
          "event": {
            "name": "offline",
            "source": "you_tube",
            "kind": "youtube.stream.offline",
            "within_ms": 15000
          }
        },
        {
          "event": {
            "name": "offline_action",
            "source": "core",
            "kind": "action.start",
            "payload": { "/action_name": { "equals": "Went Offline" } },
            "within_ms": 15000
          }
        },
        { "caused_by": { "effect": "offline_action", "cause": "offline" } },
        {
          "youtube_request": {
            "method": "GET",
            "path": "/youtube/v3/liveChat/messages",
            "status": 403,
            "within_ms": 15000
          }
        },
        {
          "event": {
            "source": "you_tube",
            "kind": "youtube.stream.offline",
            "count": { "exactly": 1 },
            "within_ms": 5000
          }
        },
        { "youtube_no_unexpected_requests": {} }
      ]
    }
  ]
}
