msg-config-required = Required
msg-config-not_a_number = Must be a number
msg-config-between = Must be between { $min } and { $max }
msg-config-at_least = Must be at least { $min }
msg-config-at_most = Must be at most { $max }
msg-config-length_between = Must be { $min } to { $max } characters long
msg-config-length_at_least = Must be at least { $min } { $min ->
    [one] character
   *[other] characters
} long
msg-config-length_at_most = Must be at most { $max } { $max ->
    [one] character
   *[other] characters
} long
msg-config-out_of_range = Out of the allowed range
msg-config-count_between = Must list { $min } to { $max } items
msg-config-count_at_least = Must list at least { $min } { $min ->
    [one] item
   *[other] items
}
msg-config-count_at_most = Must list at most { $max } { $max ->
    [one] item
   *[other] items
}
msg-config-not_text = Must be text
msg-config-any_of_required = Fill in at least one of: { $fields }
msg-config-invalid_choice = Must be one of: { $choices }
msg-config-field_problem = { $problem } ({ $field })
msg-config-unknown_entry = Not a known entry
msg-config-not_a_datetime = Must be a date and time or a unix timestamp
msg-config-timestamp_out_of_range = The unix timestamp is out of range
msg-config-not_a_step_list = Must be a list of steps
msg-config-not_json = Must be valid JSON
msg-config-not_a_json_object = Must be a JSON object
msg-config-invalid_id = Not a valid ID
msg-config-step_rejected = This step could not be checked
