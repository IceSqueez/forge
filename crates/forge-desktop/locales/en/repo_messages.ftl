msg-repo-storage_failed = forge could not read or write its data. Details are in the log.
msg-repo-item_gone = This item no longer exists. Reload the screen and try again.
msg-repo-name_taken = The name "{ $name }" is already in use.
msg-repo-value_rejected = This value was not accepted. Check it and try again.
msg-repo-still_referenced = { $count ->
        [one] It is still used by { $count } action.
       *[other] It is still used by { $count } actions.
    }
msg-repo-trigger_gone = This trigger no longer exists. It may have been deleted.
msg-repo-action_gone = This action no longer exists.
msg-repo-steps_gone = The step list of this action no longer exists.
msg-repo-operation_failed = The operation failed. Details are in the log.
msg-repo-data_dir_unavailable = forge could not create its data folder { $path }.
msg-repo-startup_stopped = The app could not finish starting. Try again.
msg-repo-file_failed = The file could not be read or written. Details are in the log.
msg-repo-server_address_busy = The server could not listen on { $address }. Another program may be using that port.
msg-repo-server_lan_disabled = This address needs LAN access, which is turned off in the server settings.
msg-repo-server_switched_off = The server is switched off in settings.
msg-repo-script_rejected = The script could not be used.
msg-repo-overlay_kind_unavailable = This overlay needs the type { $kind }, which this version of forge does not have.
msg-repo-overlay_queue_full = This overlay already has { $capacity } shows waiting, so this one was not queued.
msg-repo-overlay_slot_bound = This overlay shows a latest value and takes no content from actions.
