{
  "name": "a new subscriber raises an alert on a connected overlay page",
  "purpose": "One channel.subscribe notification reaches forge's EventSub session, becomes the bus event twitch.channel.subscribe, and runs the action bound to the new-subscriber trigger instance. The action's only step sends to an alert overlay, and the browser source connected to it receives a headline built from the subscriber's canonical variables. The subscriber's display name differs from the login only in casing, so a page that shows the login instead of %user_name% fails here. This is the whole non-chat trigger path: nothing about it goes through a chat command.",
  "fixture": {
    "twitch": {},
    "overlays": [
      {
        "display_name": "Alert Box",
        "kind_id": "overlay.alert",
        "config": {
          "headline": { "type": "string", "value": "stored headline" }
        }
      }
    ],
    "event_triggers": [
      {
        "trigger_kind": "twitch.support.subscriber",
        "action_name": "Announce Subscriber",
        "steps": [
          {
            "kind_id": "overlay.send",
            "config": {
              "overlay_id": { "type": "string", "value": "Alert Box" },
              "headline": { "type": "string", "value": "%user_name% just subscribed" }
            },
            "enabled": true
          }
        ]
      }
    ]
  },
  "fakes": {
    "twitch": {}
  },
  "steps": [
    { "do": { "forge_ready": { "within_ms": 60000 } } },
    {
      "do": { "twitch_subscribed": { "types": ["channel.subscribe"], "within_ms": 30000 } }
    },
    {
      "do": { "overlay_page": { "overlay": "Alert Box", "within_ms": 30000 } }
    },
    {
      "do": {
        "twitch_event": {
          "subscription_type": "channel.subscribe",
          "event": {
            "user_id": "200000077",
            "user_login": "luckyviewer",
            "user_name": "LuckyViewer",
            "broadcaster_user_id": "100000001",
            "broadcaster_user_login": "forge_emulator",
            "broadcaster_user_name": "forge_emulator",
            "tier": "1000",
            "is_gift": false
          }
        }
      },
      "expect": [
        {
          "event": {
            "name": "subscribed",
            "source": "twitch",
            "kind": "twitch.channel.subscribe",
            "payload": {
              "/user/login": { "equals": "luckyviewer" },
              "/tier": { "equals": "1000" },
              "/is_gift": { "equals": false }
            },
            "within_ms": 5000
          }
        },
        {
          "event": {
            "name": "started",
            "source": "core",
            "kind": "action.start",
            "payload": { "/action_name": { "equals": "Announce Subscriber" } },
            "within_ms": 5000
          }
        },
        {
          "event": {
            "name": "done",
            "source": "core",
            "kind": "action.done",
            "payload": { "/outcome": { "equals": "success" } },
            "within_ms": 5000
          }
        },
        { "caused_by": { "effect": "done", "cause": "started" } },
        {
          "overlay_content": {
            "overlay": "Alert Box",
            "values": { "headline": "LuckyViewer just subscribed" },
            "within_ms": 5000
          }
        },
        { "twitch_no_unexpected_requests": {} }
      ]
    }
  ]
}
